# Default included model. Change only if you use a different checkpoint.
MODEL_PATH=weights/best.pt
CAMERA_SOURCE=0
CONFIDENCE=0.5

# A class is counted after N consecutive frames, and can count again only
# after it disappears for RESET_FRAMES consecutive frames.
STABLE_FRAMES=5
RESET_FRAMES=3
IDLE_LOGOUT_SECONDS=10
EVENT_LOG_PATH=data/waste_events.jsonl

# Optional Firebase service-account JSON (NEVER commit this file).
# FIREBASE_CREDENTIALS=secrets/firebase-service-account.json

# Optional Arduino/UART RFID input (send lines formatted as "UID: 12345").
# RFID_PORT=/dev/ttyAMA0
RFID_BAUDRATE=9600
